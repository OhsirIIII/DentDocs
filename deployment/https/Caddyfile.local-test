# Disposable, same-machine HTTPS rehearsal. Trust the generated CA only in the
# test client; do not install it in the OS/browser or use these ports for a clinic.
{
	admin off
	persist_config off
	skip_install_trust
	auto_https disable_redirects
	default_bind 127.0.0.1
	servers {
		protocols h1 h2
	}
}

https://localhost:18443, https://dentdocs:18443 {
	tls internal
	reverse_proxy 127.0.0.1:18084
}

http://localhost:18083, http://dentdocs:18083 {
	redir https://{host}:18443{uri} 308
}
